# npm registry mirror (leave empty to use default https://registry.npmjs.org)
NPM_REGISTRY=https://registry.npmmirror.com/

# Time Zone
TIMEZONE=Asia/Shanghai

# PostgreSQL
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/skateboard_shop"

# Backend
BACKEND_PORT=3000

# JWT Authentication
ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars
REFRESH_SECRET=change-me-to-another-random-string-at-least-32-chars
ACCESS_EXPIRES=15m
REFRESH_EXPIRES=7d

# Initial SUPER_ADMIN credentials (used by seed script)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=Admin@123
SUPER_ADMIN_FORCE_RESET=false

# ngrok (optional, for public HTTPS access)
# Sign up at https://ngrok.com, get your token from dashboard
NGROK_AUTHTOKEN=your_ngrok_token_here

# Frontend — base path: / (direct) | /gfs/ (gateway) | /frpc/gfs/ (tunnel) | ./ (mobile)
VITE_BASE=/gfs/

# App root URL (where the server is accessible)
APP_BASE_URL=https://your-domain.com

# Capacitor remote mode — true = App loads from server, false = App uses bundled pages
#   npm run start     → CAPACITOR_REMOTE=false
#   npm run start:dev → CAPACITOR_REMOTE=true
CAPACITOR_REMOTE=false
