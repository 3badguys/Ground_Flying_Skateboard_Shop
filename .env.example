# ========== npm registry mirror ==========
# Leave empty to use default https://registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com/

# ========== Time Zone ==========
TIMEZONE=Asia/Shanghai

# ========== Database (single source of truth) ==========
# These feed both docker-compose and local Prisma tools.
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=skateboard_shop

# Local Prisma connection (used by `npx prisma db push` etc.)
# Inside containers, docker-compose constructs DATABASE_URL from DB_* vars above.
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/skateboard_shop"

# ========== Backend ==========
BACKEND_PORT=3000

# ========== JWT Authentication ==========
# Generate with: openssl rand -base64 32
ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars
REFRESH_SECRET=change-me-to-another-random-string-at-least-32-chars
ACCESS_EXPIRES=15m
REFRESH_EXPIRES=7d

# ========== Initial SUPER_ADMIN ==========
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=Admin@123
SUPER_ADMIN_FORCE_RESET=false

# ========== ngrok (optional) ==========
NGROK_AUTHTOKEN=your_ngrok_token_here

# ========== Frontend ==========
# Base path: / (direct) | /gfs/ (gateway) | /frpc/gfs/ (tunnel) | ./ (mobile)
VITE_BASE=/gfs/

# App root URL (where the server is accessible)
APP_BASE_URL=https://your-domain.com

# Capacitor remote mode — true = App loads from server, false = App uses bundled pages
#   npm run start     → CAPACITOR_REMOTE=false
#   npm run start:dev → CAPACITOR_REMOTE=true
CAPACITOR_REMOTE=false
